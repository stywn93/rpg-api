DELIMITER ;;
/*!50003 CREATE*/ /*!50017 DEFINER=`root`@`%`*/ /*!50003 TRIGGER `before_insert_queuelogs` BEFORE INSERT ON `queue_logs` FOR EACH ROW BEGIN
                DECLARE last_status VARCHAR(255);

                SELECT status_baru
                INTO last_status
                FROM queue_logs
                WHERE queue_id = NEW.queue_id
                ORDER BY id DESC
                LIMIT 1;

                IF last_status IS NOT NULL THEN
                    SET NEW.status_sebelumnya = last_status;
                END IF;

            END */;;
DELIMITER ;
